{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "7e68fe4e07174708aae206f0f5c63784",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "VoronoiSampleUV (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2283.333251953125,
            "y": -577.3333740234375,
            "width": 259.333251953125,
            "height": 304.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "a05539660a794785b0f513f21fffeae0"
        },
        {
            "m_Id": "533c2ea32fe841768af06a2585525915"
        },
        {
            "m_Id": "fa0388a7733a4d98a1fc6275c9b5f7af"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "VoronoiSampleUV",
    "m_FunctionSource": "",
    "m_FunctionBody": "float2 cell = floor(UV);\r\nfloat2 localPos = frac(UV);\r\n\r\nfloat minDist = 999.0;\r\nfloat2 nearestFeaturePoint = float2(0.0, 0.0);\r\n\r\n// Rotation matrix from AngleOffset\r\nfloat s = sin(AngleOffset);\r\nfloat c = cos(AngleOffset);\r\nfloat2x2 rot = float2x2(c, -s, s, c);\r\n\r\nfor (int y = -1; y <= 1; y++)\r\n{\r\n    for (int x = -1; x <= 1; x++)\r\n    {\r\n        float2 neighbor = float2(x, y);\r\n        float2 hashInput = cell + neighbor;\r\n\r\n        // Inline Hash22\r\n        float2 p = float2(\r\n            dot(hashInput, float2(127.1, 311.7)),\r\n            dot(hashInput, float2(269.5, 183.3))\r\n        );\r\n\r\n        float2 randomPoint = frac(sin(p) * 43758.5453);\r\n\r\n        // Rotate the random feature point around the center of its cell\r\n        randomPoint = mul(rot, randomPoint - 0.5) + 0.5;\r\n\r\n        float2 featurePoint = cell + neighbor + randomPoint;\r\n\r\n        float2 diff = neighbor + randomPoint - localPos;\r\n        float dist = dot(diff, diff);\r\n\r\n        if (dist < minDist)\r\n        {\r\n            minDist = dist;\r\n            nearestFeaturePoint = featurePoint;\r\n        }\r\n    }\r\n}\r\n\r\nOutUV = nearestFeaturePoint;"
}

